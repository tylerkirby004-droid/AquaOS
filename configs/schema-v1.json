{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquaos.dev/schemas/config/v1",
  "title": "AquaOS configuration schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_level": { "enum": ["debug", "info", "warn", "error"] },
        "startup_timeout": { "type": "string" },
        "shutdown_timeout": { "type": "string" },
        "component_timeout": { "type": "string" },
        "event_concurrency": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "read_timeout": { "type": "string" },
        "write_timeout": { "type": "string" },
        "idle_timeout": { "type": "string" },
        "bearer_token_file": { "type": "string" },
        "maximum_request_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "mutation_rate": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "mutation_burst": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "mqtt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "site_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "broker": { "type": "string" },
        "client_id": { "type": "string" },
        "username": { "type": "string" },
        "connect_timeout": { "type": "string" },
        "keep_alive": { "type": "string" },
        "disconnect_quiesce": { "type": "string" },
        "required_for_ready": { "type": "boolean" },
        "maximum_payload": { "type": "integer", "minimum": 256, "maximum": 16777216 },
        "queue_capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "idempotency_capacity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "reconnect_minimum": { "type": "string" },
        "reconnect_maximum": { "type": "string" },
        "reconnect_jitter": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "home_assistant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "command_ttl": { "type": "string" },
            "tombstones": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["component", "object_id"],
                "properties": {
                  "component": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
                  "object_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
                }
              }
            }
          }
        }
      }
    },
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shelly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoints": { "type": "array", "items": { "$ref": "#/$defs/shellyEndpoint" } }
          }
        },
        "esp32": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoints": { "type": "array", "items": { "$ref": "#/$defs/esp32Endpoint" } }
          }
        }
      }
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "safe_load_acknowledged": { "type": "boolean" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "influxdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string" },
            "organization": { "type": "string" },
            "bucket": { "type": "string" },
            "token_file": { "type": "string" },
            "queue_capacity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "batch_size": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "flush_interval": { "type": "string" },
            "retry_minimum": { "type": "string" },
            "retry_maximum": { "type": "string" },
            "write_timeout": { "type": "string" }
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
        "sensors": { "type": "array", "items": { "$ref": "#/$defs/sensor" } },
        "equipment": { "type": "array", "items": { "$ref": "#/$defs/equipment" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "shellyEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "equipment_id", "alarm_rule_id", "base_url", "channel", "poll_interval", "request_timeout", "retries", "safe_on", "power_return_policy", "equipment_kind"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "equipment_id": { "$ref": "#/$defs/uuid" }, "alarm_rule_id": { "$ref": "#/$defs/uuid" },
        "base_url": { "type": "string" }, "channel": { "type": "integer", "minimum": 0, "maximum": 31 },
        "poll_interval": { "type": "string" }, "request_timeout": { "type": "string" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 }, "safe_on": { "type": "boolean" },
        "power_return_policy": { "enum": ["off", "restore"] },
        "equipment_kind": { "enum": ["outlet", "heater"] },
        "maximum_on": { "type": "string" },
        "required_probe_ids": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "alarms": {
      "type": "object", "additionalProperties": false,
      "properties": { "rules": { "type": "array", "items": { "$ref": "#/$defs/alarmRule" } } }
    },
    "backups": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "destination": { "type": "string" },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "esp32Endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "device_id", "alarm_rule_id", "base_url", "probe_ids", "poll_interval", "request_timeout", "fresh_for", "maximum_clock_skew", "maximum_difference_celsius"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "device_id": { "$ref": "#/$defs/uuid" }, "alarm_rule_id": { "$ref": "#/$defs/uuid" },
        "base_url": { "type": "string" }, "bearer_token_file": { "type": "string" },
        "probe_ids": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "poll_interval": { "type": "string" }, "request_timeout": { "type": "string" }, "fresh_for": { "type": "string" },
        "maximum_clock_skew": { "type": "string" }, "maximum_difference_celsius": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "entity_id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" }, "description": { "type": "string" },
        "manufacturer": { "type": "string" }, "model": { "type": "string" }, "firmware": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sensor": {
      "type": "object", "additionalProperties": false, "required": ["id", "device_id", "unit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "entity_id": { "$ref": "#/$defs/uuid" }, "device_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" }, "quantity": { "type": "string" },
        "unit": { "enum": ["celsius", "fahrenheit", "pH", "ppt", "liters_per_hour", "boolean"] },
        "minimum": { "type": "number" }, "maximum": { "type": "number" },
        "calibration": { "$ref": "#/$defs/calibration" }
      }
    },
    "equipment": {
      "type": "object", "additionalProperties": false, "required": ["id", "device_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "entity_id": { "$ref": "#/$defs/uuid" }, "device_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" }, "kind": { "enum": ["outlet", "heater", "return-pump", "circulation-pump", "dosing-pump", "light", "ato"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["observe", "switch", "variable-output", "command-acknowledgement", "reported-state", "power-telemetry"] } },
        "hazardous": { "type": "boolean" }, "fail_safe_on": { "type": "boolean" },
        "maximum_on": { "type": "string" }, "maximum_daily_on": { "type": "string" }, "minimum_off": { "type": "string" },
        "required_sensor_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "commissioning": { "$ref": "#/$defs/commissioning" }
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }, "scale": { "type": "number" }, "offset": { "type": "number" },
        "reference": { "type": "string" }, "calibrated_by": { "type": "string" }, "calibrated_at": { "type": "string", "format": "date-time" }
      }
    },
    "commissioning": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stage": { "enum": ["uncommissioned", "discovered", "mapped", "configured", "validated", "bench-tested", "commissioned", "disabled"] },
        "safe_test_load": { "type": "boolean" }, "fail_safe_state_verified": { "type": "boolean" },
        "power_return_verified": { "type": "boolean" }, "independent_safeguard_present": { "type": "boolean" },
        "verified_by": { "type": "string" }, "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "alarmRule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "sensor_id", "condition", "severity", "delay", "clear_delay"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "sensor_id": { "$ref": "#/$defs/id" },
        "condition": { "enum": ["above", "below", "outside", "true", "false"] },
        "threshold": { "type": "number" }, "threshold_high": { "type": "number" },
        "severity": { "enum": ["info", "warning", "critical"] }, "delay": { "type": "string" }, "clear_delay": { "type": "string" },
        "latching": { "type": "boolean" }, "notifications": { "type": "array", "uniqueItems": true, "items": { "enum": ["home-assistant", "mqtt", "log"] } }
      }
    }
  }
}
