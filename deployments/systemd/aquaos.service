[Unit]
Description=AquaOS authoritative local aquarium controller
Documentation=https://github.com/tylerkirby004-droid/AquaOS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aquaos
Group=aquaos
ExecStart=/usr/local/bin/aquaos -config /etc/aquaos/aquaos.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
